  "description": "Exports parity fixtures from the TypeScript ledger engine in flowtrace/src/lib/ledger for the Rust ledger-core.",
  "scripts": {
    "export": "\"$npm_execpath\" --no-install export-fixtures.ts",
    "coverage": "\"$npm_execpath\" --no-install coverage.ts",
    "check": "\"$npm_execpath\" --no-install check.ts",
    "module-replay": "\"$npm_execpath\" --no-install module-replay.ts",
    "integration": "\"$npm_execpath\" --no-install module-integration.ts",
    "transparency-proof": "\"$npm_execpath\" --no-install transparency-proof.ts",
    "auth-proof": "\"$npm_execpath\" --no-install auth-proof.ts",
    "signin-proof": "\"$npm_execpath\" --no-install signin-proof.ts",
    "it1": "\"$npm_execpath\" --no-install it1.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.89.0"
  },
  "devDependencies": {
    "playwright-core": "1.64.0"
  }
}
