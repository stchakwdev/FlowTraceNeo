{
  // Settings required by SpacetimeDB TypeScript modules (from `spacetime init`),
  // plus `include` reaching the shared ledger engine in ../flowtrace.
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "target": "ESNext",
    "lib": ["ES2022", "dom"],
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["./src/**/*"]
}
