# Copy to .dev.vars for `bun run dev`. .dev.vars is gitignored; never commit real values.
# A SpacetimeDB token whose identity can read the module's private tables (on dev: the
# owner CLI identity's token, from `spacetime login show --token`).
MODULE_TOKEN=replace-me
# HMAC key for signed URLs, e.g. the output of `openssl rand -hex 32`.
URL_SIGNING_KEY=replace-me
