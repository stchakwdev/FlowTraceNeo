# Auth: "dummy" (default) signs everyone in as a demo user and needs no WorkOS
# vars. Set to "workos" to use the WorkOS AuthKit settings below.
VITE_AUTH_MODE=dummy

# WorkOS AuthKit
WORKOS_CLIENT_ID=client_xxx
WORKOS_API_KEY=sk_xxx
WORKOS_COOKIE_PASSWORD=32_character_minimum_secret_here
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback

# WorkOS AuthKit MCP Configuration
# Your AuthKit domain (e.g., flowtrace.authkit.app or custom domain)
WORKOS_AUTHKIT_DOMAIN=your-app.authkit.app
# Your MCP server URL (used in OAuth metadata)
MCP_SERVER_URL=http://localhost:3000

# Supabase (Database & Storage only - auth via WorkOS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
